# Home AI server settings. Written once by install.sh; later installs and
# updates leave this file alone. Restart after editing:
#   sudo systemctl restart home-ai
# No secrets belong here. Connector and AI credentials are entered in the web
# interface and stored by the application.

# HTTPS on every network interface, port 8443.
APP_LISTEN=0.0.0.0:8443
APP_TLS=self-signed
# Names the certificate was issued for (used only when it is first created).
APP_TLS_NAMES=@TLS_NAMES@

APP_DATA_DIR=/var/lib/home-ai
APP_WEB_DIR=/opt/home-ai/web
APP_LOG_LEVEL=info
