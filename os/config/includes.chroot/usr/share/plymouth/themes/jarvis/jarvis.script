# JARVIS OS boot screen (Plymouth "script" module).
#
# The owner's logo (logo.png, white on black) in the middle of a black screen,
# breathing slowly, with a thin progress line under it. It also draws the
# disk-unlock prompt: the installed system is encrypted, and with a splash
# running the passphrase is asked through Plymouth, so the prompt and the
# typed-character dots live here. Dots and bar come from
# os/plymouth/gen-assets.mjs.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = sw / 2;
cy = sh * 0.45;
unit = Math.Min(sw, sh);

# ---- the logo -------------------------------------------------------------------
logo_size = unit * 0.36;
logo_scaled = Image("logo.png").Scale(logo_size, logo_size);
logo_sprite = Sprite(logo_scaled);
logo_sprite.SetPosition(cx - logo_size / 2, cy - logo_size / 2, 2);

# ---- the progress line ------------------------------------------------------------
bar_img = Image("bar.png");
bar_width = unit * 0.36;
bar_x = cx - bar_width / 2;
bar_y = sh * 0.78;
bar_back = Sprite(bar_img.Scale(bar_width, 2));
bar_back.SetPosition(bar_x, bar_y, 4);
bar_back.SetOpacity(0.18);
bar_sprite = Sprite();
bar_sprite.SetPosition(bar_x, bar_y, 5);

# ---- the disk-unlock prompt ---------------------------------------------------------
prompt_sprite = Sprite();
prompt_sprite.SetZ(6);
dot_img = Image("dot.png");
dot_size = unit * 0.022;
dot_scaled = dot_img.Scale(dot_size, dot_size);
for (i = 0; i < 32; i++) {
  dot_sprite[i] = Sprite(dot_scaled);
  dot_sprite[i].SetPosition(cx - 16 * dot_size * 1.6 + i * dot_size * 1.6, sh * 0.9, 6);
  dot_sprite[i].SetOpacity(0);
}
message_sprite = Sprite();
message_sprite.SetZ(6);
prompting = 0;

# ---- animation ---------------------------------------------------------------------
frame = 0;
fun refresh_callback() {
  local.t = frame / 50;
  frame++;
  local.speed = 1;
  if (prompting) local.speed = 2;
  logo_sprite.SetOpacity(0.82 + 0.18 * Math.Sin(local.t * 1.6 * local.speed));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  local.w = Math.Max(1, bar_width * progress);
  bar_sprite.SetImage(bar_img.Scale(local.w, 2));
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- passphrase prompt and messages ----------------------------------------------------
fun password_callback(prompt, bullets) {
  prompting = 1;
  local.img = Image.Text(prompt, 0.8, 0.9, 1.0, 1.0, "Sans 13");
  prompt_sprite.SetImage(local.img);
  prompt_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.84, 6);
  prompt_sprite.SetOpacity(1);
  for (i = 0; i < 32; i++) {
    if (i < bullets) dot_sprite[i].SetOpacity(1);
    else dot_sprite[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  prompting = 0;
  prompt_sprite.SetOpacity(0);
  for (i = 0; i < 32; i++) dot_sprite[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun message_callback(text) {
  local.img = Image.Text(text, 0.7, 0.8, 0.9, 1.0, "Sans 11");
  message_sprite.SetImage(local.img);
  message_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.95, 6);
}
Plymouth.SetMessageFunction(message_callback);
