# Home AI / JARVIS OS boot screen (Plymouth "script" module).
#
# The owner's boot animation (home-ai-boot.html) as far as Plymouth can do it:
# the five shapes of the mark come in one after another on a near-black screen,
# a thin progress line fills, and the status line changes with the REAL boot
# progress (Initializing, Loading core, Connecting systems, Starting Home AI).
# The line-tracing effect of the HTML version is not reproduced here; it needs
# SVG, which Plymouth does not have.
#
# It must also draw the disk-unlock prompt: the installed system is encrypted,
# and with a splash running the passphrase is asked through Plymouth, so the
# prompt and the typed-character dots live here. Shapes, dot and bar come from
# os/plymouth/gen-assets.mjs.

Window.SetBackgroundTopColor(0.02, 0.02, 0.02);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.02);

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = sw / 2;
cy = sh * 0.45;
unit = Math.Min(sw, sh);

# ---- the mark: five shapes, each a full-size image placed on top of the others ----
mark_size = unit * 0.38;
shape_file[0] = "cap.png";
shape_file[1] = "left.png";
shape_file[2] = "right.png";
shape_file[3] = "inner-left.png";
shape_file[4] = "inner-right.png";
# Seconds before each shape starts to appear (as in the HTML version).
shape_delay[0] = 0.15;
shape_delay[1] = 0.55;
shape_delay[2] = 0.7;
shape_delay[3] = 1.0;
shape_delay[4] = 1.15;
for (i = 0; i < 5; i++) {
  shape_sprite[i] = Sprite(Image(shape_file[i]).Scale(mark_size, mark_size));
  shape_sprite[i].SetPosition(cx - mark_size / 2, cy - mark_size / 2, 2);
  shape_sprite[i].SetOpacity(0);
}

# ---- status line and progress line ---------------------------------------------------
bar_img = Image("bar.png");
bar_width = unit * 0.28;
bar_x = cx - bar_width / 2;
bar_y = sh * 0.78;
bar_back = Sprite(bar_img.Scale(bar_width, 1));
bar_back.SetPosition(bar_x, bar_y, 4);
bar_back.SetOpacity(0.13);
bar_sprite = Sprite();
bar_sprite.SetPosition(bar_x, bar_y, 5);

status_sprite = Sprite();
status_sprite.SetZ(5);
status_stage = -1;
fun set_status(text) {
  local.img = Image.Text(text, 0.5, 0.5, 0.5, 1.0, "Sans 9");
  status_sprite.SetImage(local.img);
  status_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.72, 5);
}
set_status("INITIALIZING");

# ---- the disk-unlock prompt ---------------------------------------------------------
prompt_sprite = Sprite();
prompt_sprite.SetZ(6);
dot_img = Image("dot.png");
dot_size = unit * 0.022;
dot_scaled = dot_img.Scale(dot_size, dot_size);
for (i = 0; i < 32; i++) {
  dot_sprite[i] = Sprite(dot_scaled);
  dot_sprite[i].SetPosition(cx - 16 * dot_size * 1.6 + i * dot_size * 1.6, sh * 0.9, 6);
  dot_sprite[i].SetOpacity(0);
}
message_sprite = Sprite();
message_sprite.SetZ(6);

# ---- animation ---------------------------------------------------------------------
frame = 0;
fun refresh_callback() {
  local.t = frame / 50;
  frame++;
  for (i = 0; i < 5; i++) {
    local.a = (local.t - shape_delay[i]) / 2.2;
    if (local.a < 0) local.a = 0;
    if (local.a > 1) local.a = 1;
    shape_sprite[i].SetOpacity(local.a * local.a);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  local.w = Math.Max(1, bar_width * progress);
  bar_sprite.SetImage(bar_img.Scale(local.w, 1));
  local.stage = 0;
  if (progress > 0.25) local.stage = 1;
  if (progress > 0.5) local.stage = 2;
  if (progress > 0.75) local.stage = 3;
  if (local.stage != status_stage) {
    status_stage = local.stage;
    if (local.stage == 0) set_status("INITIALIZING");
    if (local.stage == 1) set_status("LOADING CORE");
    if (local.stage == 2) set_status("CONNECTING SYSTEMS");
    if (local.stage == 3) set_status("STARTING HOME AI");
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- passphrase prompt and messages ----------------------------------------------------
fun password_callback(prompt, bullets) {
  local.img = Image.Text(prompt, 0.85, 0.85, 0.85, 1.0, "Sans 13");
  prompt_sprite.SetImage(local.img);
  prompt_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.84, 6);
  prompt_sprite.SetOpacity(1);
  for (i = 0; i < 32; i++) {
    if (i < bullets) dot_sprite[i].SetOpacity(1);
    else dot_sprite[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  prompt_sprite.SetOpacity(0);
  for (i = 0; i < 32; i++) dot_sprite[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun message_callback(text) {
  local.img = Image.Text(text, 0.6, 0.6, 0.6, 1.0, "Sans 11");
  message_sprite.SetImage(local.img);
  message_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.95, 6);
}
Plymouth.SetMessageFunction(message_callback);
