# JARVIS OS boot screen (Plymouth "script" module).
#
# A glowing orb that breathes, with three tilted rings turning around it, the
# name, and a thin progress line. It must also draw the disk-unlock prompt:
# the installed system is encrypted, and with a splash running the passphrase
# is asked through Plymouth, so the prompt and the typed-character dots live
# here. Images are generated by os/plymouth/gen-assets.mjs.

Window.SetBackgroundTopColor(0.012, 0.024, 0.047);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = sw / 2;
cy = sh * 0.42;
unit = Math.Min(sw, sh);
orb = unit * 0.26;

# ---- the orb -----------------------------------------------------------------
halo_img = Image("halo.png");
halo_sprite = Sprite();
halo_sprite.SetZ(1);

core_img = Image("core.png");
core_sprite = Sprite();
core_sprite.SetZ(3);

ring_base = Image("ring.png");
ring_size = orb * 3;
ring_scaled = ring_base.Scale(ring_size, ring_size);
for (i = 0; i < 3; i++) {
  ring_sprite[i] = Sprite();
  ring_sprite[i].SetZ(2);
}

# ---- the name and the progress line ---------------------------------------------
title_img = Image.Text("JARVIS OS", 0.62, 0.86, 1.0, 1.0, "Sans 20");
title_sprite = Sprite(title_img);
title_sprite.SetPosition(cx - title_img.GetWidth() / 2, sh * 0.72, 5);

bar_img = Image("bar.png");
bar_width = unit * 0.5;
bar_x = cx - bar_width / 2;
bar_y = sh * 0.78;
bar_back = Sprite(bar_img.Scale(bar_width, 2));
bar_back.SetPosition(bar_x, bar_y, 4);
bar_back.SetOpacity(0.18);
bar_sprite = Sprite();
bar_sprite.SetPosition(bar_x, bar_y, 5);
progress_value = 0;

# ---- the disk-unlock prompt ---------------------------------------------------------
prompt_sprite = Sprite();
prompt_sprite.SetZ(6);
dot_img = Image("dot.png");
dot_size = unit * 0.022;
dot_scaled = dot_img.Scale(dot_size, dot_size);
for (i = 0; i < 32; i++) {
  dot_sprite[i] = Sprite(dot_scaled);
  dot_sprite[i].SetPosition(cx - 16 * dot_size * 1.6 + i * dot_size * 1.6, sh * 0.88, 6);
  dot_sprite[i].SetOpacity(0);
}
message_sprite = Sprite();
message_sprite.SetZ(6);
prompting = 0;

# ---- animation ---------------------------------------------------------------------
frame = 0;
fun refresh_callback() {
  local.t = frame / 50;
  frame++;
  local.speed = 1;
  if (prompting) local.speed = 2;
  local.breath = 1 + 0.045 * Math.Sin(local.t * 1.6 * local.speed);
  local.size = orb * local.breath;
  core_sprite.SetImage(core_img.Scale(local.size, local.size));
  core_sprite.SetPosition(cx - local.size / 2, cy - local.size / 2, 3);

  local.glow = orb * 3.4 * local.breath;
  halo_sprite.SetImage(halo_img.Scale(local.glow, local.glow));
  halo_sprite.SetPosition(cx - local.glow / 2, cy - local.glow / 2, 1);
  halo_sprite.SetOpacity(0.7 + 0.2 * Math.Sin(local.t * 1.6 * local.speed));

  for (i = 0; i < 3; i++) {
    local.r = ring_scaled.Rotate(local.t * (0.8 + 0.5 * i) * local.speed + i * 1.1);
    ring_sprite[i].SetImage(local.r);
    ring_sprite[i].SetPosition(cx - local.r.GetWidth() / 2, cy - local.r.GetHeight() / 2, 2);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  progress_value = progress;
  local.w = Math.Max(1, bar_width * progress);
  bar_sprite.SetImage(bar_img.Scale(local.w, 2));
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- passphrase prompt and messages ----------------------------------------------------
fun password_callback(prompt, bullets) {
  prompting = 1;
  local.img = Image.Text(prompt, 0.7, 0.92, 1.0, 1.0, "Sans 13");
  prompt_sprite.SetImage(local.img);
  prompt_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.82, 6);
  prompt_sprite.SetOpacity(1);
  for (i = 0; i < 32; i++) {
    if (i < bullets) dot_sprite[i].SetOpacity(1);
    else dot_sprite[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  prompting = 0;
  prompt_sprite.SetOpacity(0);
  for (i = 0; i < 32; i++) dot_sprite[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun message_callback(text) {
  local.img = Image.Text(text, 0.6, 0.8, 0.95, 1.0, "Sans 11");
  message_sprite.SetImage(local.img);
  message_sprite.SetPosition(cx - local.img.GetWidth() / 2, sh * 0.93, 6);
}
Plymouth.SetMessageFunction(message_callback);
