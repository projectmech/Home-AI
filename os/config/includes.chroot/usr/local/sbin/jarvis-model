#!/bin/bash
# Manage the local AI model: jarvis-model status | install
#
#   sudo jarvis-model install   download the model, check it against a pinned
#                               SHA-256, put it in place and start the model server
#   jarvis-model status         show what is installed and whether the server runs
#
# The model is NOT part of the image (about 1 GB). It is downloaded once, from a
# fixed address, and only a file whose SHA-256 matches the pin below is kept. The
# model server itself (jarvis-llm.service) can talk to this computer only.
set -euo pipefail

DIR=/var/lib/jarvis-model
MODEL="$DIR/model.gguf"
# Qwen2.5 1.5B Instruct, Q4_K_M, official Qwen GGUF release (Apache-2.0).
MODEL_NAME="Qwen2.5-1.5B-Instruct (Q4_K_M)"
MODEL_URL="https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf"
MODEL_SHA256="6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e"   # pinned from CI run 43655313631 (1,117,320,736 bytes)
MODEL_MAX_BYTES=2500000000

status() {
  if [ -f "$MODEL" ]; then
    echo "model: $MODEL_NAME installed, $(stat -c %s "$MODEL") bytes, sha256 $(sha256sum "$MODEL" | cut -d' ' -f1)"
  else
    echo "model: none installed (run: sudo jarvis-model install)"
  fi
  echo "server: $(systemctl is-active jarvis-llm.service 2> /dev/null || true)"
}

install_model() {
  [ "$(id -u)" = 0 ] || { echo "run as root: sudo jarvis-model install" >&2; exit 1; }
  if [ -z "$MODEL_SHA256" ]; then
    echo "This build has no pinned hash for the model, so it will not download one." >&2
    exit 1
  fi
  install -d -m 0755 "$DIR"
  local tmp
  tmp=$(mktemp -p "$DIR" .download.XXXXXX)
  trap 'rm -f "$tmp"' EXIT
  echo "Downloading $MODEL_NAME (about 1 GB). This needs the internet."
  curl -fL --retry 3 --max-filesize "$MODEL_MAX_BYTES" -o "$tmp" "$MODEL_URL"
  local got
  got=$(sha256sum "$tmp" | cut -d' ' -f1)
  if [ "$got" != "$MODEL_SHA256" ]; then
    echo "The download does not match the pinned hash (got $got). Not installing it." >&2
    exit 1
  fi
  chmod 0644 "$tmp"
  mv -f "$tmp" "$MODEL"
  trap - EXIT
  systemctl restart jarvis-llm.service
  echo "Installed. The model server is starting; it listens on 127.0.0.1:11434 only."
  status
}

# No network on this computer? Download the model file on another computer
# (the address is MODEL_URL above), copy it onto a USB stick, plug the stick in and
# run: sudo jarvis-model install-usb
# The file is checked against the same pinned SHA-256, so a wrong or damaged file is refused.
install_usb() {
  [ "$(id -u)" = 0 ] || { echo "run as root: sudo jarvis-model install-usb" >&2; exit 1; }
  [ -n "$MODEL_SHA256" ] || { echo "This build has no pinned hash for the model." >&2; exit 1; }
  local dev found="" mnt=/mnt/jarvis-usb name
  mkdir -p "$mnt"
  while read -r dev; do
    [ -n "$dev" ] || continue
    mount -o ro "$dev" "$mnt" 2> /dev/null || continue
    for name in model.gguf qwen2.5-1.5b-instruct-q4_k_m.gguf; do
      if [ -f "$mnt/$name" ]; then
        echo "Found $name on $dev; checking it (this takes a moment)..."
        if [ "$(sha256sum "$mnt/$name" | cut -d' ' -f1)" = "$MODEL_SHA256" ]; then found="$mnt/$name"; break; fi
        echo "$name on $dev does not match the expected model (wrong or damaged file). Skipping it." >&2
      fi
    done
    if [ -n "$found" ]; then
      install -d -m 0755 "$DIR"
      cp "$found" "$DIR/.usb.tmp" && chmod 0644 "$DIR/.usb.tmp" && mv -f "$DIR/.usb.tmp" "$MODEL"
      umount "$mnt"
      systemctl restart jarvis-llm.service
      echo "Installed from the USB stick. You can remove it now."
      status
      return 0
    fi
    umount "$mnt" 2> /dev/null || true
  done < <(lsblk -rpno NAME,TYPE,FSTYPE 2> /dev/null | awk '$2 == "part" && $3 != "" && $3 != "crypto_LUKS" && $3 != "swap" {print $1}')
  echo "No USB stick with the model file was found." >&2
  echo "Put the file $MODEL_URL on a USB stick (name it model.gguf) and try again." >&2
  exit 1
}

case "${1:-status}" in
  status) status ;;
  install) install_model ;;
  install-usb) install_usb ;;
  url) echo "$MODEL_URL" ;;
  *) echo "usage: jarvis-model status | install | install-usb | url" >&2; exit 2 ;;
esac
