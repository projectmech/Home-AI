[Unit]
Description=JARVIS OS installer (only when started from the Install entry)
ConditionKernelCommandLine=|jarvis.install=1
ConditionKernelCommandLine=|jarvis.install=auto
After=systemd-user-sessions.service systemd-udev-settle.service
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/jarvis-install
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
