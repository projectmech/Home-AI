#!/bin/sh
# The guided setup (jarvis-setup) needs these; fail the build loudly if one is missing.
set -e
chmod 0755 /usr/local/sbin/jarvis-setup /usr/local/sbin/jarvis-firstboot
chmod 0644 /usr/local/lib/jarvis/netui.sh
# chvt: the first-start setup (jarvis-firstboot) gets its own virtual console.
for t in whiptail loadkeys chvt sudo iw rfkill curl; do
  command -v "$t" > /dev/null || { echo "ERROR: $t is not in the image (the guided setup needs it)" >&2; exit 1; }
done
getent group sudo > /dev/null || { echo "ERROR: the sudo group does not exist" >&2; exit 1; }
# The first-start setup runs once on the first start of an installed system.
bash -n /usr/local/sbin/jarvis-firstboot && bash -n /usr/local/sbin/jarvis-setup && bash -n /usr/local/lib/jarvis/netui.sh \
  || { echo "ERROR: a setup script has a syntax error" >&2; exit 1; }
systemctl enable jarvis-firstboot.service
